        <mxCell id="Xp5XtxFnslbDERg0TUqt-124" value="&lt;h1 style=&quot;text-align: center; margin-top: 0px;&quot;&gt;&lt;font face=&quot;Times New Roman&quot;&gt;Redis DB&lt;/font&gt;&lt;/h1&gt;&lt;h3 style=&quot;line-height: 50%;&quot;&gt;&lt;b&gt;&lt;u&gt;&lt;font face=&quot;ftpmqenne--FMMSaPiho&quot;&gt;Ключ:&lt;/font&gt;&lt;/u&gt;&lt;/b&gt;&lt;/h3&gt;&lt;p style=&quot;line-height: 50%;&quot;&gt;&lt;font face=&quot;ftpmqenne--FMMSaPiho&quot;&gt;&amp;lt;Тэг события&amp;gt;-&amp;lt;user_id&amp;gt;&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 50%;&quot;&gt;&lt;font style=&quot;&quot; face=&quot;ftpmqenne--FMMSaPiho&quot;&gt;пример: like-ee7c73b3-b0b8-4a82-97f5-c10aa9dd1614&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 50%;&quot;&gt;&lt;i&gt;&lt;font face=&quot;ftpmqenne--FMMSaPiho&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/i&gt;&lt;/p&gt;&lt;h3 style=&quot;line-height: 50%;&quot;&gt;&lt;u&gt;&lt;font face=&quot;ftpmqenne--FMMSaPiho&quot;&gt;Значение:&lt;/font&gt;&lt;/u&gt;&lt;/h3&gt;&lt;p style=&quot;line-height: 50%;&quot;&gt;&lt;font style=&quot;&quot; face=&quot;ftpmqenne--FMMSaPiho&quot;&gt;JSON&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 10%;&quot;&gt;&lt;font face=&quot;ftpmqenne--FMMSaPiho&quot;&gt;{&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 10%;&quot;&gt;&lt;font face=&quot;ftpmqenne--FMMSaPiho&quot;&gt;&quot;content_id&quot;: &quot;&lt;/font&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font face=&quot;ftpmqenne--FMMSaPiho&quot;&gt;ee7c73b3-b0b8-4a82-97f5-c10aa9dd1614&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;font-family: ftpmqenne--FMMSaPiho; background-color: initial;&quot;&gt;&quot;,&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 10%;&quot;&gt;&lt;span style=&quot;font-family: ftpmqenne--FMMSaPiho; background-color: initial;&quot;&gt;&quot;content_type&quot;: &quot;review&quot;,&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 10%;&quot;&gt;&lt;span style=&quot;font-family: ftpmqenne--FMMSaPiho; background-color: initial;&quot;&gt;...&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;line-height: 10%;&quot;&gt;&lt;font face=&quot;ftpmqenne--FMMSaPiho&quot;&gt;}&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-635" y="436" width="320" height="250" as="geometry" />
